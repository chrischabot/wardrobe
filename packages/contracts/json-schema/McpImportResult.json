{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/McpImportResult.json",
  "title": "McpImportResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "imported": {
      "type": "boolean",
      "const": true
    },
    "packageId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "exportId": {
      "type": "string"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "rows"
        ],
        "additionalProperties": false
      }
    },
    "importedAssistantGrants": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "const": "revoked"
        }
      },
      "required": [
        "count",
        "status"
      ],
      "additionalProperties": false
    },
    "sessionsRecreated": {
      "type": "number",
      "const": 0
    },
    "callingGrant": {
      "type": "object",
      "properties": {
        "grantId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "const": "active"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "grantId",
        "status",
        "note"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "imported",
    "packageId",
    "exportId",
    "tables",
    "importedAssistantGrants",
    "sessionsRecreated",
    "callingGrant",
    "summary"
  ],
  "additionalProperties": false
}
