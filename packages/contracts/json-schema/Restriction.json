{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/Restriction.json",
  "title": "Restriction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "restrictionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "healing",
        "occasional_use",
        "repair",
        "return_pending",
        "for_sale",
        "care",
        "custom"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "garmentIds": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          }
        },
        "categories": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "shirt",
              "tshirt",
              "polo",
              "knitwear",
              "sweatshirt",
              "trousers",
              "jeans",
              "shorts",
              "blazer",
              "jacket",
              "coat",
              "overshirt",
              "shoes",
              "sneakers",
              "boots",
              "socks",
              "underwear",
              "belt",
              "scarf",
              "hat",
              "gloves",
              "bag",
              "tie",
              "accessory",
              "indoor"
            ]
          }
        },
        "roles": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "base_top",
              "mid_layer",
              "outer_layer",
              "bottom",
              "one_piece",
              "footwear",
              "socks",
              "belt",
              "accessory",
              "underwear",
              "indoor"
            ]
          }
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 40
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "startsAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expectedEnd": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requiredEvidence": {
      "type": "string",
      "enum": [
        "owner_statement",
        "receipt",
        "tailor_return",
        "any_owner_command"
      ]
    },
    "liftedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "liftEvidence": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "restrictionId",
    "kind",
    "scope",
    "reason",
    "startsAt",
    "expectedEnd",
    "requiredEvidence",
    "liftedAt",
    "liftEvidence",
    "version"
  ],
  "additionalProperties": false
}
