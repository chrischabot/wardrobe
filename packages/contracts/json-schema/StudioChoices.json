{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/StudioChoices.json",
  "title": "StudioChoices",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "mode": {
      "type": "string",
      "enum": [
        "today",
        "explore"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "role": {
      "type": "string",
      "enum": [
        "base_top",
        "mid_layer",
        "outer_layer",
        "bottom",
        "one_piece",
        "footwear",
        "socks",
        "belt",
        "accessory",
        "underwear",
        "indoor"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "garmentId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "base_top",
              "mid_layer",
              "outer_layer",
              "bottom",
              "one_piece",
              "footwear",
              "socks",
              "belt",
              "accessory",
              "underwear",
              "indoor"
            ]
          },
          "category": {
            "type": "string"
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "in_storage",
                "incoming",
                "occasional",
                "not_clean",
                "restricted",
                "away",
                "not_for_today_weather",
                "recently_worn",
                "shopping_candidate"
              ]
            }
          },
          "eligibleToday": {
            "type": "boolean"
          },
          "catalogueAssetId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "assetClass": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "exact_product_photo",
                  "owner_photo",
                  "edited_rendition",
                  "illustration",
                  "demo_placeholder",
                  "imagined_rendering",
                  "composite"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "garmentId",
          "name",
          "role",
          "category",
          "badges",
          "eligibleToday",
          "catalogueAssetId",
          "assetClass",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "date",
    "role",
    "items"
  ],
  "additionalProperties": false
}
