{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/SettingsResponse.json",
  "title": "SettingsResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "homeLocationLabel": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_]+(?:\\/[A-Za-z0-9_+\\-]+)*$|^UTC$"
    },
    "deliveryTime": {
      "type": "string"
    },
    "dailyOptionCount": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    },
    "laundryRoutine": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "collectDow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "collectTime": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            },
            "returnDow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "baselineDow": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "baselineTime": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            }
          },
          "required": [
            "collectDow",
            "collectTime",
            "returnDow",
            "baselineDow",
            "baselineTime"
          ],
          "additionalProperties": false
        },
        "handWash": {
          "type": "object",
          "properties": {
            "baselineDow": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                {
                  "type": "null"
                }
              ]
            },
            "baselineTime": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            }
          },
          "required": [
            "baselineDow",
            "baselineTime"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "service",
        "handWash"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "calendarId": {
      "type": [
        "string",
        "null"
      ]
    },
    "styleDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "contentSha256": {
            "type": "string"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "authoredOn": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "documentId",
          "title",
          "version",
          "contentSha256",
          "byteLength",
          "authoredOn"
        ],
        "additionalProperties": false
      }
    },
    "connectedAssistants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grantId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "client": {
            "type": "string",
            "enum": [
              "claude",
              "chatgpt",
              "other"
            ]
          },
          "clientId": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "redirectHost": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canWrite": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "lastUsedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastOperation": {
            "type": [
              "string",
              "null"
            ]
          },
          "revokedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "grantId",
          "client",
          "clientId",
          "clientName",
          "redirectHost",
          "scopes",
          "canWrite",
          "status",
          "createdAt",
          "lastUsedAt",
          "lastOperation",
          "revokedAt"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "gmail",
              "calendar",
              "drive",
              "sheets",
              "search",
              "browser",
              "mcp",
              "assistant_grant"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "connected",
              "needs_reauth",
              "missing_permission",
              "disconnected",
              "error"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                },
                "missingPermission": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "available",
                "missingPermission"
              ],
              "additionalProperties": false
            }
          },
          "lastSuccessAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastSuccessOperation": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "reconnectUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "client": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "protocolVersion": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "connectionId",
          "kind",
          "displayName",
          "status",
          "capabilities",
          "lastSuccessAt",
          "lastSuccessOperation",
          "lastError",
          "reconnectUrl",
          "client",
          "scopes"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "simulated": {
          "type": "boolean"
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "simulated",
        "profiles"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "homeLocationLabel",
    "timezone",
    "deliveryTime",
    "dailyOptionCount",
    "laundryRoutine",
    "version"
  ],
  "additionalProperties": false
}
