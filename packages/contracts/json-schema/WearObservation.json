{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/WearObservation.json",
  "title": "WearObservation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "wearingDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_]+(?:\\/[A-Za-z0-9_+\\-]+)*$|^UTC$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "app",
        "web",
        "conversation",
        "mcp",
        "import",
        "offline_replay",
        "calendar",
        "system"
      ]
    },
    "sourceRef": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "segment": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "garmentId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "role": {
            "type": "string",
            "enum": [
              "base_top",
              "mid_layer",
              "outer_layer",
              "bottom",
              "one_piece",
              "footwear",
              "socks",
              "belt",
              "accessory",
              "underwear",
              "indoor"
            ]
          },
          "freshUnit": {
            "type": "boolean"
          }
        },
        "required": [
          "garmentId"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retracted"
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "supersedesObservationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "observationId",
    "wearingDate",
    "timezone",
    "occurredAt",
    "reportedAt",
    "source",
    "sourceRef",
    "segment",
    "items",
    "status",
    "revision",
    "supersedesObservationId",
    "version"
  ],
  "additionalProperties": false
}
