{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/RunEvent.json",
  "title": "RunEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string"
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "run_started",
            "activity",
            "text_delta",
            "outfit_board",
            "product_comparison",
            "sources",
            "command_receipt",
            "needs_input",
            "run_finished",
            "snapshot"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "eventId",
    "runId",
    "type",
    "at",
    "data"
  ],
  "additionalProperties": false
}
