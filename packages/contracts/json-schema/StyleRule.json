{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/StyleRule.json",
  "title": "StyleRule",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "ruleKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "kind": {
      "type": "string",
      "enum": [
        "hard_rule",
        "standing_direction",
        "temporary_brief"
      ]
    },
    "strength": {
      "type": "string",
      "enum": [
        "hard",
        "soft"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "socks",
        "footwear",
        "thermal",
        "variety",
        "swap",
        "naming",
        "colour",
        "register",
        "filter",
        "accessories",
        "fabric",
        "construction",
        "size",
        "advice",
        "board_format",
        "day_brief",
        "comfort"
      ]
    },
    "statement": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    },
    "machine": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "exceptionPolicy": {
      "type": "string",
      "enum": [
        "none",
        "owner_scoped",
        "restriction_lift_only"
      ]
    },
    "documentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "documentVersion": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "passage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "section": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "section",
            "quote"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "passageStatus": {
      "type": "string",
      "enum": [
        "present",
        "missing",
        "not_applicable"
      ]
    },
    "overridesRuleKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "validFrom": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "validTo": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_activation",
        "retired"
      ]
    },
    "source": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ruleId",
    "ruleKey",
    "kind",
    "strength",
    "category",
    "statement",
    "interpretation",
    "machine",
    "exceptionPolicy",
    "documentId",
    "documentVersion",
    "passage",
    "passageStatus",
    "overridesRuleKey",
    "validFrom",
    "validTo",
    "status",
    "source",
    "version"
  ],
  "additionalProperties": false
}
