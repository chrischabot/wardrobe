{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/NativeTokenResponse.json",
  "title": "NativeTokenResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "token_type": {
      "type": "string",
      "const": "Bearer"
    },
    "expires_in": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "refresh_token": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "access_token",
    "token_type",
    "expires_in",
    "refresh_token",
    "scope"
  ],
  "additionalProperties": false
}
