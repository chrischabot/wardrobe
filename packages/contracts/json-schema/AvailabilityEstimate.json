{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/AvailabilityEstimate.json",
  "title": "AvailabilityEstimate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "estimatorVersion": {
      "type": "string",
      "const": "availability-estimator/1"
    },
    "garmentId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "targetDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "eligible": {
      "type": "boolean"
    },
    "exclusionReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimatedCleanUnits": {
      "type": "number",
      "minimum": 0
    },
    "expectedInferredWears": {
      "type": "number",
      "minimum": 0
    },
    "probabilityAvailable": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "likelyAvailable": {
      "type": "boolean"
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "physical_clean",
              "weekly_reset",
              "owner_exception",
              "board_probability",
              "selection",
              "recorded_wear",
              "hard_exclusion",
              "not_laundered"
            ]
          },
          "detail": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "probability": {
            "type": "number"
          },
          "boardDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "resetCycle": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "kind",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "estimatorVersion",
    "garmentId",
    "asOf",
    "targetDate",
    "eligible",
    "exclusionReasons",
    "estimatedCleanUnits",
    "expectedInferredWears",
    "probabilityAvailable",
    "likelyAvailable",
    "basis"
  ],
  "additionalProperties": false
}
