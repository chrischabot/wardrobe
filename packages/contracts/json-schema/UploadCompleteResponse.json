{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/UploadCompleteResponse.json",
  "title": "UploadCompleteResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "uploadId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "finalized",
        "rejected"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "assetId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "uploadId",
    "status",
    "reason"
  ],
  "additionalProperties": false
}
