{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/RunInputResponse.json",
  "title": "RunInputResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "status": {
      "type": "string",
      "enum": [
        "executed",
        "declined",
        "expired"
      ]
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "2026-10-01"
            },
            "commandId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
            },
            "idempotencyKey": {
              "type": "string"
            },
            "commandType": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "committed",
                "merged",
                "rejected",
                "conflict"
              ]
            },
            "replayed": {
              "type": "boolean"
            },
            "rebased": {
              "type": "boolean"
            },
            "affected": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "entityType": {
                    "type": "string",
                    "enum": [
                      "user",
                      "owner_settings",
                      "garment",
                      "stock_lot",
                      "restriction",
                      "wear_observation",
                      "daily_wear",
                      "laundry_batch",
                      "laundry_reset",
                      "board",
                      "selection",
                      "lifecycle_project",
                      "order_line",
                      "style_document",
                      "saved_combination",
                      "media_asset",
                      "service_pause"
                    ]
                  },
                  "entityId": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "change": {
                    "type": "string",
                    "enum": [
                      "created",
                      "updated",
                      "retracted"
                    ]
                  }
                },
                "required": [
                  "entityType",
                  "entityId",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "summary": {
              "type": "string"
            },
            "facts": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "effects": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "projection_pending",
                    "projected",
                    "failed"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "effectId": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 80,
                        "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "board_revalidation",
                          "calendar_projection",
                          "search_index",
                          "media_job",
                          "notification"
                        ]
                      },
                      "external": {
                        "type": "boolean"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "dispatched",
                          "projected",
                          "failed",
                          "superseded"
                        ]
                      },
                      "operationKey": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "effectId",
                      "kind",
                      "external",
                      "status",
                      "operationKey"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            "undo": {
              "type": "object",
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "available"
              ],
              "additionalProperties": false
            },
            "compensatesCommandId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 80,
                  "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "undoneByCommandId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 80,
                  "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "error": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "schemaVersion",
            "commandId",
            "idempotencyKey",
            "commandType",
            "outcome",
            "replayed",
            "rebased",
            "affected",
            "summary",
            "facts",
            "effects",
            "undo",
            "compensatesCommandId",
            "undoneByCommandId",
            "occurredAt",
            "recordedAt",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
