            "replayed": {
              "type": "boolean"
            },
            "result": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "operation",
            "idempotencyKey",
            "replayed",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "run": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "receipt",
    "run"
  ],
  "additionalProperties": false
}
