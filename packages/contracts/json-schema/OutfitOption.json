{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/OutfitOption.json",
  "title": "OutfitOption",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "optionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "boardId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "position": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "slots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "garmentId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "role": {
            "type": "string",
            "enum": [
              "base_top",
              "mid_layer",
              "outer_layer",
              "bottom",
              "one_piece",
              "footwear",
              "socks",
              "belt",
              "accessory",
              "underwear",
              "indoor"
            ]
          },
          "alternativeGroup": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "garmentId",
          "role",
          "alternativeGroup"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "offerable",
        "reserve",
        "withdrawn"
      ]
    },
    "validation": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "optionId",
    "boardId",
    "revision",
    "position",
    "slots",
    "explanation",
    "status",
    "validation"
  ],
  "additionalProperties": false
}
