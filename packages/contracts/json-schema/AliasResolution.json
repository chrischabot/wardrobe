{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/AliasResolution.json",
  "title": "AliasResolution",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "resolved"
        },
        "phrase": {
          "type": "string"
        },
        "garmentId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "phrase",
        "garmentId",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ambiguous"
        },
        "phrase": {
          "type": "string"
        },
        "candidates": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "garmentId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
              },
              "name": {
                "type": "string"
              },
              "distinguishing": {
                "type": "string"
              }
            },
            "required": [
              "garmentId",
              "name",
              "distinguishing"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "phrase",
        "candidates"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "not_found"
        },
        "phrase": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "phrase"
      ],
      "additionalProperties": false
    }
  ]
}
