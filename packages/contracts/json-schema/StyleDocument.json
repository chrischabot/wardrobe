{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/StyleDocument.json",
  "title": "StyleDocument",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "isDemo": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "enum": [
        "owner_supplied",
        "owner_edit",
        "import",
        "synthetic_test"
      ]
    },
    "authoredOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "importedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "isCurrent": {
      "type": "boolean"
    },
    "integrity": {
      "type": "string",
      "enum": [
        "ok",
        "mismatch"
      ]
    }
  },
  "required": [
    "documentId",
    "version",
    "title",
    "body",
    "contentSha256",
    "byteLength",
    "isDemo",
    "source",
    "authoredOn",
    "importedAt",
    "isCurrent"
  ],
  "additionalProperties": false
}
