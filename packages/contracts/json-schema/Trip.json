{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/Trip.json",
  "title": "Trip",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tripId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "departsOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "returnsOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "timezone"
        ],
        "additionalProperties": {}
      }
    },
    "timezone": {
      "type": "string"
    },
    "luggage": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "packed",
        "completed",
        "cancelled"
      ]
    },
    "allowRepeats": {
      "type": "boolean"
    },
    "occasions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "occasion": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "occasion"
        ],
        "additionalProperties": false
      }
    },
    "packedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "unpackedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "tripId",
    "name",
    "departsOn",
    "returnsOn",
    "destinations",
    "timezone",
    "luggage",
    "status",
    "allowRepeats",
    "occasions",
    "packedAt",
    "unpackedAt",
    "version"
  ],
  "additionalProperties": false
}
