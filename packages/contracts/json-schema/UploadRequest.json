{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/UploadRequest.json",
  "title": "UploadRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "enum": [
        "garment_photo",
        "identify",
        "what_i_wore",
        "product",
        "receipt"
      ]
    },
    "contentType": {
      "type": "string",
      "enum": [
        "image/jpeg",
        "image/heic",
        "image/png"
      ]
    },
    "byteLength": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 25000000
    },
    "garmentId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "purpose",
    "contentType",
    "byteLength"
  ],
  "additionalProperties": false
}
