{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/Garment.json",
  "title": "Garment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "garmentId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "shirt",
        "tshirt",
        "polo",
        "knitwear",
        "sweatshirt",
        "trousers",
        "jeans",
        "shorts",
        "blazer",
        "jacket",
        "coat",
        "overshirt",
        "shoes",
        "sneakers",
        "boots",
        "socks",
        "underwear",
        "belt",
        "scarf",
        "hat",
        "gloves",
        "bag",
        "tie",
        "accessory",
        "indoor"
      ]
    },
    "roles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "base_top",
          "mid_layer",
          "outer_layer",
          "bottom",
          "one_piece",
          "footwear",
          "socks",
          "belt",
          "accessory",
          "underwear",
          "indoor"
        ]
      }
    },
    "maker": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "productName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "productCode": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "fabric": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "color": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "colorFamily": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "pattern": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "sizeLabel": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "careChannel": {
      "type": "string",
      "enum": [
        "service",
        "hand_wash",
        "dry_clean",
        "none"
      ]
    },
    "laundryPolicy": {
      "type": "string",
      "enum": [
        "per_wear",
        "single_wear_day",
        "multi_wear",
        "never"
      ]
    },
    "tracking": {
      "type": "string",
      "enum": [
        "unit",
        "anonymous_quantity"
      ]
    },
    "acquisition": {
      "type": "string",
      "enum": [
        "incoming",
        "owned",
        "disposed"
      ]
    },
    "disposalReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "sold",
            "donated",
            "discarded",
            "returned",
            "lost",
            "fabricated_entry"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "planningPolicy": {
      "type": "string",
      "enum": [
        "normal",
        "occasional",
        "excluded"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "good",
        "worn",
        "needs_repair",
        "damaged",
        "unknown"
      ]
    },
    "location": {
      "type": "string",
      "enum": [
        "home",
        "storage",
        "tailor",
        "repair",
        "trip",
        "consignment",
        "in_transit",
        "unknown"
      ]
    },
    "locationDetail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "attributes": {
      "type": "object",
      "properties": {
        "construction": {
          "type": "string",
          "maxLength": 60
        },
        "fabricClass": {
          "type": "string",
          "maxLength": 60
        },
        "weight": {
          "type": "string",
          "enum": [
            "light",
            "mid",
            "heavy"
          ]
        },
        "minTempC": {
          "type": "number",
          "minimum": -40,
          "maximum": 50
        },
        "maxTempC": {
          "type": "number",
          "minimum": -40,
          "maximum": 50
        },
        "indoorOnly": {
          "type": "boolean"
        },
        "season": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "spring",
              "summer",
              "autumn",
              "winter"
            ]
          }
        },
        "tags": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "wearLoggingSince": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "garmentId",
    "name",
    "category",
    "roles",
    "maker",
    "productName",
    "productCode",
    "fabric",
    "color",
    "colorFamily",
    "pattern",
    "sizeLabel",
    "careChannel",
    "laundryPolicy",
    "tracking",
    "acquisition",
    "disposalReason",
    "planningPolicy",
    "condition",
    "location",
    "locationDetail",
    "attributes",
    "notes",
    "wearLoggingSince",
    "version",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
