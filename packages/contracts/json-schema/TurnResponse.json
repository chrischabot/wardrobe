{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/TurnResponse.json",
  "title": "TurnResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "clientTurnId": {
      "type": "string"
    },
    "messageId": {
      "type": "string"
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "existing",
        "queued"
      ]
    },
    "notice": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "secret_removed"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "redacted": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "title",
        "summary",
        "redacted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "clientTurnId",
    "messageId",
    "runId",
    "status"
  ],
  "additionalProperties": false
}
