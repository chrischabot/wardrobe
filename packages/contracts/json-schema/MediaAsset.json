{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/MediaAsset.json",
  "title": "MediaAsset",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "source",
        "cutout",
        "catalogue",
        "mask",
        "thumbnail",
        "composite"
      ]
    },
    "assetClass": {
      "type": "string",
      "enum": [
        "exact_product_photo",
        "owner_photo",
        "edited_rendition",
        "illustration",
        "demo_placeholder",
        "imagined_rendering",
        "composite"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "final",
        "rejected"
      ]
    },
    "contentType": {
      "type": "string"
    },
    "width": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "height": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "byteLength": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceAssetId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "op",
          "provider",
          "at",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourcePageUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrievedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "permittedUse": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "sourceUrl",
        "sourcePageUrl",
        "retrievedAt",
        "permittedUse",
        "evidence"
      ],
      "additionalProperties": false
    },
    "fidelity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "garment_identity",
                      "dominant_colours",
                      "pattern",
                      "details",
                      "silhouette",
                      "clipping",
                      "halo",
                      "components"
                    ]
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "passed",
                  "detail"
                ],
                "additionalProperties": false
              }
            },
            "maxColourDeltaE": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "passed",
            "checks",
            "maxColourDeltaE"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "garmentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "assetId",
    "kind",
    "assetClass",
    "status",
    "contentType",
    "width",
    "height",
    "byteLength",
    "sha256",
    "sourceAssetId",
    "transformations",
    "provenance",
    "fidelity",
    "label",
    "garmentIds",
    "createdAt"
  ],
  "additionalProperties": false
}
