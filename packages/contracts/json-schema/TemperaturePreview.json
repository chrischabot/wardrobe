{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/TemperaturePreview.json",
  "title": "TemperaturePreview",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "simulation": {
      "type": "boolean",
      "const": true
    },
    "temperatureC": {
      "type": "number"
    },
    "basis": {
      "type": "string",
      "enum": [
        "peak",
        "departure"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "garmentId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "base_top",
              "mid_layer",
              "outer_layer",
              "bottom",
              "one_piece",
              "footwear",
              "socks",
              "belt",
              "accessory",
              "underwear",
              "indoor"
            ]
          },
          "wearable": {
            "type": "boolean"
          },
          "inStorage": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "garmentId",
          "name",
          "role",
          "wearable",
          "inStorage",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "simulation",
    "temperatureC",
    "items",
    "note"
  ],
  "additionalProperties": false
}
