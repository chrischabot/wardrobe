{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/PackingProposalResponse.json",
  "title": "PackingProposalResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "tripId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "garments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "garmentId": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 80,
                  "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              },
              "required": [
                "garmentId",
                "name",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "garments",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "garmentId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "garmentId",
          "name",
          "quantity"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "tripId",
    "days",
    "items",
    "notes"
  ],
  "additionalProperties": false
}
