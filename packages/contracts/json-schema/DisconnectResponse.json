{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/DisconnectResponse.json",
  "title": "DisconnectResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "connectionId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "const": "disconnected"
    },
    "cancelledCalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remoteRevocation": {
      "type": "string",
      "enum": [
        "revoked",
        "failed",
        "not_supported",
        "not_applicable"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "connectionId",
    "status",
    "cancelledCalls",
    "remoteRevocation"
  ],
  "additionalProperties": false
}
