{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/LaundryRoutine.json",
  "title": "LaundryRoutine",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "object",
      "properties": {
        "collectDow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "collectTime": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "returnDow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "baselineDow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "baselineTime": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        }
      },
      "required": [
        "collectDow",
        "collectTime",
        "returnDow",
        "baselineDow",
        "baselineTime"
      ],
      "additionalProperties": false
    },
    "handWash": {
      "type": "object",
      "properties": {
        "baselineDow": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            {
              "type": "null"
            }
          ]
        },
        "baselineTime": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        }
      },
      "required": [
        "baselineDow",
        "baselineTime"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "service",
    "handWash"
  ],
  "additionalProperties": false
}
