{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/CancelRunResponse.json",
  "title": "CancelRunResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2026-10-01"
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "input_required",
        "finished",
        "cancelled",
        "failed"
      ]
    },
    "committedEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "commandId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation",
          "commandId"
        ],
        "additionalProperties": false
      }
    },
    "stopped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "committedEffects",
    "stopped"
  ],
  "additionalProperties": false
}
