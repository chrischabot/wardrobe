{
  "$id": "https://garderobe.invalid/contracts/2026-10-01/TurnRequest.json",
  "title": "TurnRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clientTurnId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9:._\\-]+$"
    },
    "text": {
      "type": "string",
      "maxLength": 20000
    },
    "attachmentIds": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
      }
    },
    "references": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "garment"
              },
              "garmentId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "kind",
              "garmentId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "option"
              },
              "boardId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
              },
              "optionId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "pattern": "^[a-z]{1,6}_[A-Za-z0-9_-]+$"
              },
              "boardRevision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "boardId",
              "optionId",
              "boardRevision"
            ]
          }
        ]
      }
    },
    "intent": {
      "default": "chat",
      "type": "string",
      "enum": [
        "chat",
        "add_item",
        "identify",
        "what_i_wore"
      ]
    },
    "explicitLog": {
      "default": false,
      "type": "boolean"
    },
    "sourceChannel": {
      "default": "app",
      "type": "string",
      "const": "app"
    },
    "stopCurrent": {
      "type": "boolean"
    }
  },
  "required": [
    "clientTurnId",
    "text"
  ],
  "additionalProperties": false
}
