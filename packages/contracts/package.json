{
  "name": "@garderobe/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned Garderobe API and domain contracts (zod schemas, TypeScript types, JSON Schema)",
  "exports": {
    ".": "./src/index.ts",
    "./json-schema/*": "./json-schema/*"
  },
  "scripts": {
    "schemas": "tsx scripts/emit-json-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
