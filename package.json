{
  "name": "garderobe",
  "private": true,
  "version": "0.1.0",
  "description": "Garderobe: private wardrobe companion (Cloudflare backend, SwiftUI app, MCP interface)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "demo",
    "data",
    "tests/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test --workspace @garderobe/contracts && npm run test --workspace @garderobe/backend",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p deploy/tsconfig.json",
    "schemas": "npm run schemas --workspace @garderobe/contracts",
    "db:migrate:local": "npm run db:migrate:local --workspace @garderobe/backend",
    "seed:demo": "npm run seed --workspace @garderobe/demo",
    "test:adversarial": "npm run test --workspace @garderobe/adversarial-tests",
    "test:journeys": "npm run test --workspace @garderobe/journey-tests",
    "deploy:dev": "tsx deploy/scripts/dev.ts deploy",
    "dev:provision": "tsx deploy/scripts/dev.ts provision",
    "dev:seed": "tsx deploy/scripts/dev.ts seed",
    "dev:probe": "tsx deploy/scripts/dev.ts probe",
    "dev:verify": "tsx deploy/scripts/dev.ts verify",
    "dev:measure": "tsx deploy/scripts/dev.ts measure",
    "teardown:dev": "tsx deploy/scripts/dev.ts teardown"
  }
}
