{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Garderobe Worker. Local-only configuration: no account IDs, secrets or deployed resource IDs.
  // The deployment workstream replaces the placeholder IDs; the API/MCP, assistant and daily-service
  // workstreams make small additive edits (routes, secrets names, crons).
  "name": "garderobe",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // global_fetch_strictly_public: required by @cloudflare/workers-oauth-provider to fetch Client ID
  // Metadata Documents (CIMD) safely (API/MCP workstream).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // D1 owns wardrobe facts, command receipts and effects (spec section 4).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "garderobe",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],

  // Private R2: media, renditions, exports and backups.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "garderobe-media-local" }],

  // OAUTH_KV is required by @cloudflare/workers-oauth-provider (MCP authorization, section 13).
  // CACHE_KV holds non-personal caches (weather keyed without user identifiers).
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000001" },
    { "binding": "CACHE_KV", "id": "00000000000000000000000000000002" }
  ],

  // Queues: search-index projection and media jobs fed from the transactional outbox.
  "queues": {
    "producers": [
      { "binding": "INDEX_QUEUE", "queue": "garderobe-index" },
      { "binding": "MEDIA_QUEUE", "queue": "garderobe-media" }
    ],
    // Visual catalogue jobs (src/media/pipeline.ts). A message carries only { v, userId, jobId }.
    "consumers": [
      { "queue": "garderobe-media", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },

  // Workflows own long multi-step jobs (evening composition, morning validation, imports).
  "workflows": [
    { "name": "garderobe-daily-service", "binding": "DAILY_SERVICE_WORKFLOW", "class_name": "DailyServiceWorkflow" }
  ],

  // Think assistant actor on SQLite Durable Objects (assistant workstream installs @cloudflare/think).
  "durable_objects": {
    "bindings": [{ "name": "ASSISTANT", "class_name": "GarderobeAssistant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GarderobeAssistant"] }],

  // Workers AI binding; all inference is routed through AI Gateway (section 12).
  "ai": { "binding": "AI" },

  // Non-secret configuration. AI Gateway identifiers are placeholders; secrets (search API keys,
  // Google OAuth client secret, grant encryption key) are configured with `wrangler secret`, never here.
  "vars": {
    "ENVIRONMENT": "local",
    "AI_GATEWAY_ID": "garderobe-gateway-placeholder",
    "AI_GATEWAY_ACCOUNT_ID": "",
    "DEFAULT_TIMEZONE": "Europe/London",
    // HTTP API / MCP / auth (API/MCP workstream). Local values; the deployment replaces them with
    // the real Access team domain, AUD tags and hostnames. The local Access signing key is a JWKS in
    // .dev.vars (ACCESS_JWKS_JSON), created by `npm run dev:auth --workspace @garderobe/backend`.
    "ACCESS_TEAM_DOMAIN": "https://garderobe-local.cloudflareaccess.com",
    "ACCESS_AUD": "garderobe-local-app",
    "APP_HOSTNAMES": "localhost,127.0.0.1",
    "APP_ORIGIN": "http://localhost:8787",
    "MCP_ORIGIN": "http://localhost:8787",
    "NATIVE_REDIRECT_URIS": "garderobe://auth/callback",
    "WEATHER_PROVIDER": "open-meteo"
  }
}
